{
  "name": "buildit-web",
  "version": "0.1.0",
  "private": true,
  "description": "Talk to your room: an editable 3D room planner where an AI agent rearranges furniture through a geometry-checked layout engine.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
