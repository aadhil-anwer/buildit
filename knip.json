{
  "ignore": [
    ".claude/**",
    "design-docnew/**",
    "web/**",
    "tools/fixtures/**",
    "supabase/functions/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "tools/*.test.ts"
      ],
      "ignoreDependencies": [
        "react",
        "react-dom"
      ]
    },
    "packages/core": {
      "entry": [
        "src/**/*.ts",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/mobile": {
      "entry": [
        "src/app/**/*.tsx",
        "src/**/*.test.{ts,tsx}",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "ignoreBinaries": [
    "supabase"
  ]
}
