{
  "name": "buildit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 28",
    "dup": "jscpd packages --min-lines 8 --min-tokens 60 --threshold 0 --silent --ignore \"**/node_modules/**,**/tests/**\"",
    "dead": "knip",
    "test": "npm test --workspaces --if-present && vitest run tools",
    "verify": "npm run typecheck && npm run lint && npm run dup && npm run dead && npm test"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=22.6"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
