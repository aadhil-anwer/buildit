{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "scripts",
    "*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
