{
  "name": "@buildit/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@buildit/core": "*",
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.8.1",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.117.3",
    "@types/jest": "29.5.14",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lucide-react-native": "^1.55.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.10.1",
    "three": "0.186.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.2",
    "@types/three": "0.186.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^3.4.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "tokens": "node scripts/gen-tokens.ts",
    "strings": "node scripts/gen-strings.ts",
    "web": "expo start --web --port 8081",
    "design:compare": "node scripts/design-compare.ts",
    "hero": "node scripts/gen-hero.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}",
      "<rootDir>/scripts/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 20000,
    "clearMocks": true,
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|three))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
