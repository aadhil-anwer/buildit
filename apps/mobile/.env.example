# Copy to .env.local and fill in. Only public values belong here: anything EXPO_PUBLIC_* ships inside the app.
# Local values come from `npx supabase status` in the repo root.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Required in release builds. Get it from the Sentry project settings.
EXPO_PUBLIC_SENTRY_DSN=
